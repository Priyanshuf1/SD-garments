# ==============================================================================
# GENRAGE STREETWEAR D2C PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your keys
# ==============================================================================

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL Database, Auth & Storage)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. CASHFREE PAYMENT GATEWAY (UPI, Cards, Netbanking)
# Get from: https://merchant.cashfree.com/merchants/settings/api-keys
# ------------------------------------------------------------------------------
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX # Use 'PRODUCTION' for live payments
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# ------------------------------------------------------------------------------
# 3. DELHIVERY B2C LOGISTICS (Automated AWB Shipping & Tracking)
# Get from: https://one.delhivery.com/
# ------------------------------------------------------------------------------
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_CLIENT_NAME=GENRAGE_EXPRESS
DELHIVERY_WAREHOUSE_PINCODE=400050
DELHIVERY_ENV=staging # Use 'production' for live courier dispatch

# ------------------------------------------------------------------------------
# 4. GOKWIK 1-CLICK CHECKOUT (Optional Headless Fast UPI)
# ------------------------------------------------------------------------------
GOKWIK_MERCHANT_ID=
GOKWIK_APP_KEY=
GOKWIK_ENV=sandbox
