# Copy to a local secret store; do not commit a populated .env file.
NODE_ENV=production
PORT=3000
APP_DOMAIN=alleyrich.com
APP_ORIGIN=https://alleyrich.com
TRUST_PROXY=false

DB_NAME=alleyrich_production
DB_USER=replace-me
DB_PASSWORD=replace-me
DATABASE_URL=postgres://replace-me:replace-me@postgres:5432/alleyrich_production?sslmode=disable

ADMIN_SECRET_KEY=generate-a-random-32-byte-key
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=generate-a-long-password
ADMIN_2FA_SECRET=generate-a-new-base32-totp-secret
AUTH_SESSION_SECRET=generate-a-random-32-byte-key

# Leave Cashfree blank only when COD-only operation is intentional.
CASHFREE_ENV=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

DELHIVERY_ENV=production
DELHIVERY_API_TOKEN=replace-me
DELHIVERY_WAREHOUSE_NAME=SD Garments
DELHIVERY_WAREHOUSE_PINCODE=209721
DELHIVERY_CLIENT_NAME=SD Garments

# Transactional Email Providers
# Brevo (Sendinblue): Permanent free tier of 300 emails/day to ANY recipient (Recommended)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alleyrich11@gmail.com
BREVO_SENDER_NAME=ALLEYRICH

# Resend: Secondary fallback provider
RESEND_API_KEY=
RESEND_FROM_EMAIL=ALLYRICH <support@alleyrich.com>

GEMINI_API_KEY=

# Phase 1: Server-Authoritative Pricing & Inventory
STRICT_PRICING_ENFORCED=true
MAX_CART_ITEMS=50
MAX_QTY_PER_ITEM=10
DROP_ITEM_MAX_QTY=2
IDEMPOTENCY_REQUIRED=false
SHIPPING_FEE_INR=99
COD_FEE_PAISE=0
TAX_RATE_PERCENT=0

# Phase 2: Shared State, Sessions & Auth Hardening
ALLOW_JSON_FALLBACK=true
REDIS_AUTH_FAIL_CLOSED=false
GLOBAL_OTP_LIMIT_PER_MINUTE=60
CSRF_PROTECTION_ENABLED=true
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_MODE=open

# Phase 3: Headers, Admin Hardening, Audit & Marketing Controls
CSP_ENFORCE=false
DEBUG_CSP=false
ADMIN_IP_ALLOWLIST=
CF_ACCESS_ENABLED=false
CF_ACCESS_AUD=

# Phase 4: Gateway-Ready Payment Foundation (Disabled by default)
ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 5: COD Risk (Shadow Mode First)
COD_RISK_MODE=shadow
COD_RISK_SURCHARGE_PAISE=9900
HIGH_COD_THRESHOLD_INR=6000
CRITICAL_COD_THRESHOLD_INR=10000
MAX_COD_VALUE_INR=50000
COD_CONFIRMATION_ENABLED=false
COD_CONFIRMATION_TIMEOUT_MINUTES=60
