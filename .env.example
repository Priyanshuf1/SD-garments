# Copy to a local secret store; do not commit a populated .env file.
NODE_ENV=production
PORT=3000
APP_DOMAIN=alleyrich.com
APP_ORIGIN=https://alleyrich.com
TRUST_PROXY=false

DB_NAME=alleyrich_production
DB_USER=replace-me
DB_PASSWORD=replace-me
DATABASE_URL=postgres://replace-me:replace-me@postgres:5432/alleyrich_production?sslmode=disable

ADMIN_SECRET_KEY=generate-a-random-32-byte-key
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=generate-a-long-password
ADMIN_2FA_SECRET=generate-a-new-base32-totp-secret
AUTH_SESSION_SECRET=generate-a-random-32-byte-key

# Leave Cashfree blank only when COD-only operation is intentional.
CASHFREE_ENV=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

DELHIVERY_ENV=production
DELHIVERY_API_TOKEN=replace-me
DELHIVERY_WAREHOUSE_NAME=SD Garments
DELHIVERY_WAREHOUSE_PINCODE=209721
DELHIVERY_CLIENT_NAME=SD Garments

# Transactional Email Providers
# Brevo (Sendinblue): Permanent free tier of 300 emails/day to ANY recipient (Recommended)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alleyrich11@gmail.com
BREVO_SENDER_NAME=ALLEYRICH

# Resend: Secondary fallback provider
RESEND_API_KEY=
RESEND_FROM_EMAIL=ALLYRICH <support@alleyrich.com>

# Optional Webhooks (Legacy / Self-Hosted)
N8N_ORDER_WEBHOOK_URL=
N8N_OTP_WEBHOOK_URL=
GEMINI_API_KEY=
