# Copy to .env locally. Use a secret manager in production; never commit .env.
NODE_ENV=production
PORT=3000
APP_DOMAIN=alleyrich.com
APP_ORIGIN=https://alleyrich.com
TRUST_PROXY=true
AUTH_SESSION_SECRET=generate-a-random-32-byte-value

DB_NAME=alleyrich_production
DB_USER=alleyrich_admin
DB_PASSWORD=generate-a-long-random-database-password
DATABASE_URL=postgres://alleyrich_admin:replace-me@postgres:5432/alleyrich_production?sslmode=disable

ADMIN_SECRET_KEY=generate-a-random-32-byte-admin-api-key
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=generate-a-long-admin-password
ADMIN_2FA_SECRET=generate-a-new-base32-totp-secret

CASHFREE_ENV=production
CASHFREE_APP_ID=replace-me
CASHFREE_SECRET_KEY=replace-me
DELHIVERY_API_TOKEN=replace-me
DELHIVERY_ENV=production
DELHIVERY_WAREHOUSE_NAME=SD Garments
DELHIVERY_WAREHOUSE_PINCODE=209721
DELHIVERY_CLIENT_NAME=SD Garments

RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=ALLYRICH <support@alleyrich.com>
N8N_ORDER_WEBHOOK_URL=
N8N_OTP_WEBHOOK_URL=
